@page

@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="mb-4">

        <h1 class="display-5">
            Olympiad Database Viewer
        </h1>

        <p class="text-muted">
            ASP.NET Core Razor Pages + PostgreSQL
        </p>

    </div>


    <!-- ========================================================= -->
    <!-- QUICK INFO -->
    <!-- ========================================================= -->

    <div class="row">

        <!-- TABLES -->

        <div class="col-md-6 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h3 class="card-title mb-3">
                        Tables
                    </h3>

                    <p class="card-text">
                        Просмотр и редактирование данных
                        олимпийской базы данных.
                    </p>

                </div>

            </div>

        </div>


        <!-- REPORTS -->

        <div class="col-md-6 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h3 class="card-title mb-3">
                        Reports
                    </h3>

                    <p class="card-text">
                        Аналитические отчеты по олимпийским данным.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- FEATURES -->
    <!-- ========================================================= -->

    <div class="card shadow-sm">

        <div class="card-body">

            <h3 class="mb-3">
                Возможности системы
            </h3>

            <div class="row">

                <div class="col-md-4">

                    <ul>
                        <li>Просмотр таблиц</li>
                        <li>CRUD операции</li>
                        <li>Поиск по строкам</li>
                    </ul>

                </div>

                <div class="col-md-4">

                    <ul>
                        <li>Фильтрация данных</li>
                        <li>Сортировка столбцов</li>
                        <li>Просмотр VIEW отчетов</li>
                    </ul>

                </div>

                <div class="col-md-4">

                    <ul>
                        <li>Экспорт в Excel</li>
                        <li>Работа с PostgreSQL</li>
                        <li>Razor Pages UI</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>