@page

@model OlympiadViewer.Pages.Tables.Countries.CreateModel

@{
    ViewData["Title"] = "Create Country";
}

<h2 class="mb-4">
    Create Country
</h2>

<div class="form-container">

    <form method="post">

        <div class="mb-3">

            <label class="form-label">
                Country Code
            </label>

            <input asp-for="Country.CountryCode"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Name
            </label>

            <input asp-for="Country.Name"
                   class="form-control" />

        </div>

        <button type="submit"
                class="btn btn-success">

            Save

        </button>

        <a asp-page="Index"
           class="btn btn-secondary">

            Back

        </a>

    </form>

</div>