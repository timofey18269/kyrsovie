@page "{id}"

@model OlympiadViewer.Pages.Tables.Countries.DeleteModel

@{
    ViewData["Title"] = "Delete Country";
}

<h2 class="mb-4 text-danger">
    Delete Country
</h2>

<div class="alert alert-warning">

    Are you sure you want to delete this country?

</div>

<div class="form-container">

    <dl class="row">

        <dt class="col-sm-2">
            Code
        </dt>

        <dd class="col-sm-10">
            @Model.Country.CountryCode
        </dd>

        <dt class="col-sm-2">
            Name
        </dt>

        <dd class="col-sm-10">
            @Model.Country.Name
        </dd>

    </dl>

    <form method="post">

        <button type="submit"
                class="btn btn-danger">

            Delete

        </button>

        <a asp-page="Index"
           class="btn btn-secondary">

            Cancel

        </a>

    </form>

</div>