@page "{id:int}"

@model OlympiadViewer.Pages.Tables.EventSchedules.DeleteModel

@{
    ViewData["Title"] = "Delete Schedule";
}

<h2 class="mb-4 text-danger">
    Delete Schedule
</h2>

<div class="alert alert-warning">

    Are you sure you want to delete this schedule?

</div>

<div class="form-container">

    <dl class="row">

        <dt class="col-sm-3">
            Sport
        </dt>

        <dd class="col-sm-9">
            @Model.EventSchedule.Sport?.SportName
        </dd>

        <dt class="col-sm-3">
            Date
        </dt>

        <dd class="col-sm-9">
            @Model.EventSchedule.StartDate.ToString("dd.MM.yyyy")
        </dd>

        <dt class="col-sm-3">
            Start Time
        </dt>

        <dd class="col-sm-9">
            @Model.EventSchedule.StartTime
        </dd>

        <dt class="col-sm-3">
            End Time
        </dt>

        <dd class="col-sm-9">
            @Model.EventSchedule.EndTime
        </dd>

        <dt class="col-sm-3">
            Venue
        </dt>

        <dd class="col-sm-9">
            @Model.EventSchedule.Venue?.Name
        </dd>

    </dl>

    <form method="post">

        <button type="submit"
                class="btn btn-danger">

            Delete

        </button>

        <a asp-page="Index"
           class="btn btn-secondary">

            Cancel

        </a>

    </form>

</div>