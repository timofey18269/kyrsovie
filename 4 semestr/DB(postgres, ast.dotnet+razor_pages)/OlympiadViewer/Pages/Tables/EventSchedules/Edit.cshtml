@page "{id:int}"

@model OlympiadViewer.Pages.Tables.EventSchedules.EditModel

@{
    ViewData["Title"] = "Edit Schedule";
}

<h2 class="mb-4">
    Edit Schedule
</h2>

<div class="form-container">

    <form method="post">

        <input type="hidden"
               asp-for="EventSchedule.StartId" />

        <div class="mb-3">

            <label class="form-label">
                Sport
            </label>

            <select asp-for="EventSchedule.SportId"
                    asp-items="Model.Sports"
                    class="form-select">
            </select>

        </div>

        <div class="mb-3">

            <label class="form-label">
                Date
            </label>

            <input asp-for="EventSchedule.StartDate"
                   type="date"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Start Time
            </label>

            <input asp-for="EventSchedule.StartTime"
                   type="time"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                End Time
            </label>

            <input asp-for="EventSchedule.EndTime"
                   type="time"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Venue
            </label>

            <select asp-for="EventSchedule.VenueId"
                    asp-items="Model.Venues"
                    class="form-select">
            </select>

        </div>

        <button type="submit"
                class="btn btn-warning">

            Save

        </button>

        <a asp-page="Index"
           class="btn btn-secondary">

            Back

        </a>

    </form>

</div>