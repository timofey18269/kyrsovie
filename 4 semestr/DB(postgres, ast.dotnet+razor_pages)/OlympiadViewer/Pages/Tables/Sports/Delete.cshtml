@page "{id:int}"

@model OlympiadViewer.Pages.Tables.Sports.DeleteModel

@{
    ViewData["Title"] = "Delete Sport";
}

<h2 class="mb-4 text-danger">
    Delete Sport
</h2>

<div class="alert alert-warning">

    Are you sure you want to delete this sport?

</div>

<div class="form-container">

    <dl class="row">

        <dt class="col-sm-2">
            ID
        </dt>

        <dd class="col-sm-10">
            @Model.Sport.SportId
        </dd>

        <dt class="col-sm-2">
            Name
        </dt>

        <dd class="col-sm-10">
            @Model.Sport.SportName
        </dd>

        <dt class="col-sm-2">
            Type
        </dt>

        <dd class="col-sm-10">
            @Model.Sport.SportType
        </dd>

    </dl>

    <form method="post">

        <button type="submit"
                class="btn btn-danger">

            Delete

        </button>

        <a asp-page="Index"
           class="btn btn-secondary">

            Cancel

        </a>

    </form>

</div>