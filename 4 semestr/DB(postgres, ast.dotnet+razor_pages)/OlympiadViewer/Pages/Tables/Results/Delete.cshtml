@page "{id:int}"

@model OlympiadViewer.Pages.Tables.Results.DeleteModel

@{
    ViewData["Title"] = "Delete Result";
}

<h2 class="mb-4 text-danger">
    Delete Result
</h2>

<div class="alert alert-warning">

    Are you sure you want to delete this result?

</div>

<div class="form-container">

    <dl class="row">

        <dt class="col-sm-3">
            Participant
        </dt>

        <dd class="col-sm-9">
            @Model.Result.Participant?.FullName
        </dd>

        <dt class="col-sm-3">
            Sport
        </dt>

        <dd class="col-sm-9">
            @Model.Result.Sport?.SportName
        </dd>

        <dt class="col-sm-3">
            Start ID
        </dt>

        <dd class="col-sm-9">
            @Model.Result.StartId
        </dd>

        <dt class="col-sm-3">
            Place
        </dt>

        <dd class="col-sm-9">
            @Model.Result.Place
        </dd>

        <dt class="col-sm-3">
            Result
        </dt>

        <dd class="col-sm-9">
            @Model.Result.ResultValue
        </dd>

    </dl>

    <form method="post">

        <button type="submit"
                class="btn btn-danger">

            Delete

        </button>

        <a asp-page="Index"
           class="btn btn-secondary">

            Cancel

        </a>

    </form>

</div>