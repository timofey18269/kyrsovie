@page "{id:int}"

@model OlympiadViewer.Pages.Tables.Participants.DeleteModel

@{
    ViewData["Title"] = "Delete Participant";
}

<h2 class="mb-4 text-danger">
    Delete Participant
</h2>

<div class="alert alert-warning">

    Are you sure you want to delete this participant?

</div>

<div class="form-container">

    <dl class="row">

        <dt class="col-sm-3">
            Full Name
        </dt>

        <dd class="col-sm-9">
            @Model.Participant.FullName
        </dd>

        <dt class="col-sm-3">
            Country
        </dt>

        <dd class="col-sm-9">
            @Model.Participant.Country?.Name
        </dd>

        <dt class="col-sm-3">
            Sport
        </dt>

        <dd class="col-sm-9">
            @Model.Participant.Sport?.SportName
        </dd>

    </dl>

    <form method="post">

        <button type="submit"
                class="btn btn-danger">

            Delete

        </button>

        <a asp-page="Index"
           class="btn btn-secondary">

            Cancel

        </a>

    </form>

</div>