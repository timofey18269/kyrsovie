@page

@model OlympiadViewer.Pages.Tables.Participants.CreateModel

@{
    ViewData["Title"] = "Create Participant";
}

<h2 class="mb-4">
    Create Participant
</h2>

<div class="form-container">

    <form method="post">

        <div class="mb-3">

            <label class="form-label">
                Full Name
            </label>

            <input asp-for="Participant.FullName"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Country
            </label>

            <select asp-for="Participant.CountryCode"
                    asp-items="Model.Countries"
                    class="form-select">

                <option value="">
                    Select Country
                </option>

            </select>

        </div>

        <div class="mb-3">

            <label class="form-label">
                Sport
            </label>

            <select asp-for="Participant.SportId"
                    asp-items="Model.Sports"
                    class="form-select">

                <option value="">
                    Select Sport
                </option>

            </select>

        </div>

        <div class="mb-3">

            <label class="form-label">
                Birth Date
            </label>

            <input asp-for="Participant.BirthDate"
                   type="date"
                   class="form-control" />

        </div>

        <button type="submit"
                class="btn btn-success">

            Save

        </button>

        <a asp-page="Index"
           class="btn btn-secondary">

            Back

        </a>

    </form>

</div>