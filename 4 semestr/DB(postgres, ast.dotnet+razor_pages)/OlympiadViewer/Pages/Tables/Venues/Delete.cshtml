@page "{id:int}"

@model OlympiadViewer.Pages.Tables.Venues.DeleteModel

@{
    ViewData["Title"] = "Delete Venue";
}

<h2 class="mb-4 text-danger">
    Delete Venue
</h2>

<div class="alert alert-warning">

    Are you sure you want to delete this venue?

</div>

<div class="form-container">

    <dl class="row">

        <dt class="col-sm-3">
            Name
        </dt>

        <dd class="col-sm-9">
            @Model.Venue.Name
        </dd>

        <dt class="col-sm-3">
            Location
        </dt>

        <dd class="col-sm-9">
            @Model.Venue.Location
        </dd>

        <dt class="col-sm-3">
            Possible Sports
        </dt>

        <dd class="col-sm-9">
            @string.Join(", ",
            Model.Venue.PossibleSports
            ?? Array.Empty<int>())
        </dd>

    </dl>

    <form method="post">

        <button type="submit"
                class="btn btn-danger">

            Delete

        </button>

        <a asp-page="Index"
           class="btn btn-secondary">

            Cancel

        </a>

    </form>

</div>